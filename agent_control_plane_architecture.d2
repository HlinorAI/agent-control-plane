customer: Customer Environment {
  repo: GitHub / GitLab repositories
  runtime: Kubernetes / Docker metadata
  mcp: MCP configs and registries
  otel: OpenTelemetry metadata
  runner: Read-only collector / agentctl
}

control: Agent Control Plane {
  api: Ingestion API
  queue: Scan Job Queue
  normalize: Parsers + Normalizer
  resolve: Entity Resolver
  evidence: Evidence Store
  inventory: Inventory + Relationship Store
  rules: Explainable Risk Rules
  findings: Findings + Lifecycle
  ui: Web UI + API
  integrations: GitHub / Jira / Slack
}

customer.repo -> customer.runner: read-only
customer.runtime -> customer.runner: read-only
customer.mcp -> customer.runner: read-only
customer.otel -> customer.runner: metadata-only
customer.runner -> control.api: TLS signed batches
control.api -> control.queue: async jobs
control.queue -> control.normalize
control.normalize -> control.resolve
control.resolve -> control.evidence: provenance + hashes
control.resolve -> control.inventory: entities + relationships
control.inventory -> control.rules
control.evidence -> control.rules: source evidence
control.rules -> control.findings: severity + remediation hint
control.findings -> control.ui
control.findings -> control.integrations
control.inventory -> control.ui
control.evidence -> control.ui

trust1: Customer trust boundary
trust2: Control-plane trust boundary
customer.runner.style.stroke-dash: 5
trust1: {shape: rectangle; style.stroke-dash: 5; style.stroke: "#64748b"}
trust2: {shape: rectangle; style.stroke-dash: 5; style.stroke: "#2563eb"}
